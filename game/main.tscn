[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://game/session.gd" id="1_session"]
[ext_resource type="Script" path="res://game/road_strip.gd" id="2_road_strip"]
[ext_resource type="Script" path="res://game/daylight_bar.gd" id="3_daylight_bar"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_session")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
